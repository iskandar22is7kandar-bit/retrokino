# ============================================================
# RetroKino — Environment Variables Template
# ============================================================
# Railway deploy qilganda shu o'zgaruvchilarni to'ldiring

# Supabase Settings
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Site URL (Railway deploy URL ni kiriting, masalan: https://retrokino-production.up.railway.app)
NEXT_PUBLIC_SITE_URL=https://your-railway-app.up.railway.app

# Admin Panel Secret Key
ADMIN_SECRET_KEY=your_secure_admin_secret_key_here
